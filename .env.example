# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://octower:octower@localhost:5432/octower?schema=public

# ── API ─────────────────────────────────────────────────────────────────
API_PORT=4000
CORS_ORIGINS=http://localhost:3000
# Directory watched by CSV_FILE sources and used for uploaded files
INGESTION_DATA_DIR=./data/inbox

# ── Authentication (Microsoft Entra ID / OIDC) ─────────────────────────
# Set AUTH_ENABLED=true in real environments. When false the API runs with
# a local development identity (admin role) so the stack works out of the box.
AUTH_ENABLED=false
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_API_AUDIENCE=api://order-control-tower

# ── Observability ───────────────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=control-tower-api
LOG_LEVEL=info

# ── Web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_ENABLED=false
NEXT_PUBLIC_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_ENTRA_API_SCOPE=api://order-control-tower/access_as_user
