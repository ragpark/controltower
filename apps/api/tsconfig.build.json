{
  "extends": "./tsconfig.json",
  // rootDir is pinned so the emitted layout stays dist/main.js regardless of
  // which files the compilation set happens to include. prisma/ is excluded:
  // the seed is compiled separately into dist-seed by the Dockerfile, and
  // pulling it in here would move every output down a directory.
  "compilerOptions": {
    "rootDir": "src"
  },
  "exclude": ["node_modules", "test", "dist", "dist-seed", "prisma", "**/*spec.ts"]
}
